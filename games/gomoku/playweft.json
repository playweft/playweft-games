{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/gomoku/",
  "version": "1.0.1",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Gomoku",
  "name_localized": {
    "zh-CN": "五子棋"
  },
  "description": "Take turns placing stones and be first to connect five in any direction.",
  "description_localized": {
    "zh-CN": "黑白交锋，横、竖或斜线抢先连成五子。"
  },
  "categories": [
    "Strategy"
  ],
  "icons": [
    {
      "src": "../gomoku.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#d9aa63",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
