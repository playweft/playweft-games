{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/mahjong/",
  "version": "0.1.1",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Mahjong",
  "name_localized": {
    "zh-CN": "麻将"
  },
  "description": "Draw, call, declare riichi, and chase a winning hand in Japanese mahjong.",
  "description_localized": {
    "zh-CN": "摸牌、鸣牌、立直和牌，来一场紧张刺激的日式麻将。"
  },
  "categories": [
    "Table game"
  ],
  "icons": [
    {
      "src": "../mahjong.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#083f38",
  "theme_color": "#0d675b",
  "orientation": "landscape",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 4
      },
      "server": {
        "runtime": "lua",
        "entry": "./game-online.lua",
        "persistence": "durable"
      }
    }
  }
}
