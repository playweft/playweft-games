{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/sudoku/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Sudoku",
  "name_localized": {
    "zh-CN": "数独"
  },
  "description": "Choose a challenge and fill every row, column, and box.",
  "description_localized": {
    "zh-CN": "从简单到极难，填满每一行、每一列和每个九宫格。"
  },
  "categories": [
    "Puzzle"
  ],
  "icons": [
    {
      "src": "../sudoku.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f5f5f0",
  "theme_color": "#1e6e59",
  "help_url": "./help.html"
}
