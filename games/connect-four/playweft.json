{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/connect-four/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Connect Four",
  "name_localized": {
    "zh-CN": "四子棋"
  },
  "description": "Drop pieces in turn and be first to connect four in any direction.",
  "description_localized": {
    "zh-CN": "轮流落下棋子，横、竖或斜线抢先连成四子。"
  },
  "categories": [
    "Strategy"
  ],
  "icons": [
    {
      "src": "../connect-four.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#2463eb",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
